// sysdash : autorise uniquement l'utilisateur "sysdash" à démarrer apt-upgrade.service.
// Aucune autre unité, aucun autre verbe (stop, restart, enable…), aucun autre utilisateur.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "apt-upgrade.service" &&
        action.lookup("verb") === "start" &&
        subject.user === "sysdash") {
        return polkit.Result.YES;
    }
});
